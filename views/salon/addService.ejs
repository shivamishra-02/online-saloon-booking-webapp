<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Add Service</title>
</head>
<body>

<h2>Add Service</h2>

<form action="/salon/<%= salonId %>/add-service" method="POST">
    <input type="text" name="name" placeholder="Service Name" required><br><br>
    <input type="number" name="price" placeholder="Price" required><br><br>

    <input type="text" name="slots" placeholder="Slots (comma separated e.g. 10AM,11AM)" required><br><br>

    <button type="submit">Add Service</button>
</form>

</body>
</html>