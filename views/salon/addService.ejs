<%- include("../partials/header") %>

<h2 class="mb-4">Add Service</h2>

<div class="card shadow p-4 col-md-6 mx-auto">
    <form action="/salon/<%= salonId %>/add-service" method="POST">

        <div class="mb-3">
            <label class="form-label">Service Name</label>
            <input type="text" name="name" class="form-control" placeholder="Haircut / Beard" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Price (₹)</label>
            <input type="number" name="price" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Slots</label>
            <input type="text" name="slots" class="form-control" placeholder="10AM,11AM,12PM" required>
        </div>

        <button class="btn btn-success w-100">Add Service</button>

    </form>
</div>

<%- include("../partials/footer") %>