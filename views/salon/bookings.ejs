<%- include("../partials/header") %>

<h2 class="mb-4">Salon Bookings</h2>

<% if (bookings.length === 0) { %>
    <div class="alert alert-info">No bookings yet</div>
<% } %>

<div class="row">
<% bookings.forEach(b => { %>

    <div class="col-md-4">
        <div class="card shadow mb-3">
            <div class="card-body">
                <h5 class="card-title"><%= b.salon.name %></h5>

                <p><strong>User:</strong> <%= b.user.name %></p>
                <p><strong>Email:</strong> <%= b.user.email %></p>
                <p><strong>Service:</strong> <%= b.service.name %></p>
                <p><strong>Slot:</strong> <%= b.slot %></p>
            </div>
        </div>
    </div>

<% }) %>
</div>

<%- include("../partials/footer") %>