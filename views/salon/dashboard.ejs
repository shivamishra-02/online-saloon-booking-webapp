<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Salon Dashboard</title>
</head>
<body>

<h2>Salon Dashboard</h2>

<% if (!salon) { %>

    <h3>No Salon Found</h3>
    <a href="/salon/add">Add Salon</a>

<% } else { %>

    <h3>Your Salon: <%= salon.name %></h3>
    <p>Location: <%= salon.location %></p>

    <hr>

    <a href="/salon/<%= salon._id %>/add-service">Add Service</a><br><br>

    <a href="/salon/bookings">View Bookings</a>

<% } %>

</body>
</html>