<%- include("../partials/header") %>

<h2 class="mb-4">Salon Dashboard</h2>

<% if (!salon) { %>

    <div class="card p-4 text-center shadow col-md-6 mx-auto">
        <h4>No Salon Found</h4>
        <p>Add your salon to get started</p>
        <a href="/salon/add" class="btn btn-dark">Add Salon</a>
    </div>

<% } else { %>

    <div class="card shadow p-4 mb-4">
        <h3><%= salon.name %></h3>
        <p class="text-muted">📍 <%= salon.location %></p>
    </div>

    <div class="d-flex gap-3">

        <a href="/salon/<%= salon._id %>/add-service" class="btn btn-success">
            Add Service
        </a>

        <a href="/salon/bookings" class="btn btn-primary">
            View Bookings
        </a>

    </div>

<% } %>

<%- include("../partials/footer") %>