<%- include("../partials/header") %>

<h2>My Bookings</h2>

<div class="row">
<% bookings.forEach(b => { %>

    <div class="col-md-4">
        <div class="card shadow mb-3">
            <div class="card-body">
                <h5><%= b.salon.name %></h5>
                <p>Service: <%= b.service.name %></p>
                <p>Slot: <%= b.slot %></p>
            </div>
        </div>
    </div>

<% }) %>
</div>

<%- include("../partials/footer") %>