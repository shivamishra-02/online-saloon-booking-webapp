<%- include("../partials/header") %>

<h2><%= salon.name %></h2>
<p class="text-muted"><%= salon.location %></p>

<hr>

<div class="row">
<% services.forEach(service => { %>

    <div class="col-md-4">
        <div class="card mb-3 shadow">
            <div class="card-body">
                <h5><%= service.name %></h5>
                <p>₹<%= service.price %></p>

                <% service.slots.forEach(slot => { %>

                    <% 
                        const isBooked = bookings.some(b => 
                            b.service.toString() === service._id.toString() && b.slot === slot
                        );
                    %>

                    <% if (!isBooked) { %>
                        <form action="/user/book" method="POST" class="d-inline">
                            <input type="hidden" name="serviceId" value="<%= service._id %>">
                            <input type="hidden" name="slot" value="<%= slot %>">
                            <button class="btn btn-success btn-sm mb-1"><%= slot %></button>
                        </form>
                    <% } else { %>
                        <button class="btn btn-secondary btn-sm mb-1" disabled>
                            <%= slot %>
                        </button>
                    <% } %>

                <% }) %>
            </div>
        </div>
    </div>

<% }) %>
</div>

<%- include("../partials/footer") %>