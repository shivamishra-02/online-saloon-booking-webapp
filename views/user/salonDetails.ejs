<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Salon Details</title>
</head>
<body>

<h2><%= salon.name %></h2>
<p>Location: <%= salon.location %></p>

<hr>

<h3>Services</h3>

<% if (services.length === 0) { %>
    <p>No services available</p>
<% } %>

<% services.forEach(service => { %>
    <div style="border:1px solid black; margin:10px; padding:10px;">
        <h4><%= service.name %></h4>
        <p>Price: ₹<%= service.price %></p>

        <p>Slots:</p>
        <% service.slots.forEach(slot => { %>

            <% 
                const isBooked = bookings.some(b => 
                b.service.toString() === service._id.toString() && b.slot === slot
                );
            %>

            <% if (!isBooked) { %>
                <form action="/user/book" method="POST" style="display:inline;">
                    <input type="hidden" name="serviceId" value="<%= service._id %>">
                    <input type="hidden" name="slot" value="<%= slot %>">
                    <button type="submit"><%= slot %></button>
                </form>
            <% } else { %>
                <button disabled><%= slot %> (Booked)</button>
            <% } %>

        <% }) %>
    </div>
<% }) %>

</body>
</html>